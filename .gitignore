# ─── توليد الترجمات (يُعاد توليدها بالأمر: flutter gen-l10n) ───
# ⭐ الملفات المولَّدة تُكتب في lib/l10n (بجانب ملفات .arb) لأن
#   الحزمة الاصطناعية package:flutter_gen أُلغيت في Flutter 3.32+.
#   ملفات .arb نفسها **لا تُتجاهل** — فهي المصدر الحقيقي للترجمة.
lib/generated/
lib/l10n/app_localizations.dart
lib/l10n/app_localizations_*.dart
l10n_missing.txt

