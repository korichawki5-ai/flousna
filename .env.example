# ═══════════════════════════════════════════════════════════════
#  .env.example — قائمة متغيرات البناء (مرجع توثيقي)
#
#  🔴 انتبه: التطبيق **لا يقرأ ملف .env إطلاقاً** (لا حزمة dotenv فيه).
#     هذا الملف مرجع يوثّق كل المتغيرات التي يمكن حقنها، وقيمها الافتراضية.
#
#  ✅ الطريقة الفعلية للحقن — وقت البناء عبر `--dart-define`:
#
#     flutter build apk --release `
#       --dart-define=RELEASE_STATE=live `
#       --dart-define=ANPDP_DECLARATION_NUMBER=XXXX/XXXX `
#       --dart-define=DPO_EMAIL=privacy@falousna.dz `
#       --dart-define=WHATSAPP_BUSINESS_NUMBER=213555123456
#
#     (وفي CI تُحفظ القيم كـ Secrets وتُمرَّر بنفس الطريقة)
#
#  ⚠️ قواعد أمان إلزامية:
#     1. إن حفظت قيمك الحقيقية في ملف محلي (مثلاً .env) فلا ترفعه أبداً
#        — وهو مُدرَج في .gitignore لهذا السبب.
#     2. 🔴 مفتاح Service Role لا يُحقن في التطبيق إطلاقاً
#        → يُستخدم فقط داخل Supabase Edge Functions (المرحلة 3).
#     3. ✅ مفتاح anon آمن داخل التطبيق لأن RLS هي الحماية الحقيقية.
#     4. 🔴 لا تفاصيل دفع ولا أرقام حسابات في أي متغير أو كود —
#        تُرسل يدوياً في محادثة واتساب فقط (المرحلة 4).
# ═══════════════════════════════════════════════════════════════

# ── حالة النشر القانونية (الأهم) ──
# draft = التطبيق لا يجمع ولا يزامن أي بيانات شخصية
# live  = يتطلب أيضاً رقم تصريح ANPDP أدناه
# القيمتان: draft | live
RELEASE_STATE=draft

# ── رقم تصريح معالجة المعطيات لدى ANPDP (القانون 18-07 المعدّل بـ 25-11) ──
# 🔴 بدونه تبقى canProcessPersonalData = false حتى مع RELEASE_STATE=live
#    (بوابة مزدوجة مقصودة: لا معالجة بيانات قبل التصريح)
ANPDP_DECLARATION_NUMBER=

# ── وضع التطوير أو الإنتاج ──
# القيمتان: development | production
APP_ENV=development

# ── بريد مندوب حماية المعطيات DPO (إلزامي — القانون 25-11) ──
# يظهر للمستخدم في «المزيد ← القانوني ← التواصل مع مندوب الحماية»
DPO_EMAIL=privacy@falousna.dz

# ── بريد الدعم العام ──
SUPPORT_EMAIL=support@falousna.dz

# ── واتساب (طلب رموز تفعيل الاشتراك — المرحلة 4) ──
# ⚠️ بالصيغة الدولية بدون + وبدون أصفار بادئة: 213555123456
WHATSAPP_BUSINESS_NUMBER=213000000000

# ── قنوات التواصل الرسمية (تسويق — «المزيد ← تابعنا» و«حول التطبيق») ──
# 🔴 القناة الفارغة = مخفية تماماً في الواجهة (قاعدة صفر روابط ميتة)
# ⏸️ من المرحلة 4: تُدار هذه القيم من لوحة الإدارة بدون كود ولا إعادة
#    بناء (إعداد بعيد فوق مزامنة المرحلة 3) — اليوم تُحقن بـ --dart-define
SOCIAL_FACEBOOK_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_TIKTOK_URL=
SOCIAL_X_URL=
SOCIAL_YOUTUBE_URL=
SOCIAL_TELEGRAM_URL=
SOCIAL_WHATSAPP_URL=

# ── موقع التحميل والتحديثات خارج المتجر (المرحلة 6) ──
DOWNLOAD_SITE_URL=https://falousna.pages.dev
VERSION_JSON_URL=https://falousna.pages.dev/version.json

# ── Supabase (المرحلة 3 — اتركها فارغة الآن، التطبيق يعمل بدونها) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── المنطقة: Frankfurt (eu-central-1) — الأقرب للجزائر (~40-60ms) ──
# ⚠️ توثيق فقط (لا يُحقن): نقل المعطيات خارج الوطن يحتاج ترخيصاً مسبقاً
#    من ANPDP قبل تشغيل المزامنة (المادة 44).
SUPABASE_REGION=eu-central-1
